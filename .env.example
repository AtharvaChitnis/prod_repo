NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/quarry
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Leave S3 unset to store uploads on local disk (development only).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=data/objects

# Optional Atlas Vector Search index name. In-process hybrid search is used when unset.
VECTOR_INDEX=
